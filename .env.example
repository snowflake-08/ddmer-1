# ===== Database (Neon PostgreSQL) =====
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# ===== R2 Object Storage (Cloudflare) =====
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=kirameku-files
# Optional: custom public URL for R2 (e.g., CDN domain)
# R2_PUBLIC_URL=https://your-r2-cdn.example.com

# ===== JWT Secret =====
SECRET_KEY=your-secret-key-at-least-32-characters

# ===== GitHub OAuth =====
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
ADMIN_GITHUB_USERS=your_github_username

# ===== Frontend =====
FRONTEND_ORIGIN=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com

# ===== Web Push（浏览器订阅通知，可选功能） =====
# 不填 = 功能关闭：前台不显示「开启更新提醒」按钮，后台会直接显示未启用原因
# 开启步骤：
#   1) 服务器上执行 pnpm vapid:keys 生成一对密钥
#   2) 把生成的公钥/私钥填到下面两项并重新部署（不要保留示例占位值）
#   3) 确认数据库存在 push_subscription 表（npx prisma db push 或执行 init.sql）
# VAPID_SUBJECT 填一个能联系到你的邮箱（mailto:you@example.com）或站点地址
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ===== Optional: Novel API (reader-master) =====
# NEXT_PUBLIC_NOVEL_API_URL=http://your-server:18080
# NOVEL_API_URL=http://your-server:18080

# ===== Optional: Resend Email =====
# RESEND_API_KEY=re_xxxxx
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_NOVEL_API_URL=http://your-server:18080
NOVEL_API_URL=http://your-server:18080
